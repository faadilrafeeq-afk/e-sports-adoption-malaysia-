{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Most Popular E-Sports Games in Malaysia",
  "width": 650,
  "height": 400,
  "data": {
    "values": [
      {"game": "Mobile Legends: Bang Bang", "popularity": 100},
      {"game": "PUBG Mobile", "popularity": 75},
      {"game": "Dota 2", "popularity": 62},
      {"game": "Valorant", "popularity": 58},
      {"game": "League of Legends", "popularity": 48},
      {"game": "CS:GO / CS2", "popularity": 35}
    ]
  },
  "layer": [
    {"mark": {"type": "rule", "color": "#ddd"}},
    {"mark": {"type": "point", "filled": true, "size": 120, "color": "#667eea"}}
  ],
  "encoding": {
    "x": {"field": "popularity", "type": "quantitative", "title": "Popularity Score (0-100)"},
    "y": {"field": "game", "type": "nominal", "sort": "-x", "title": "Game Title"},
    "tooltip": [
      {"field": "game", "type": "nominal", "title": "Game"},
      {"field": "popularity", "type": "quantitative", "title": "Popularity Score"}
    ]
  }
}
